[Unit]
Description=Auto Forex MT5 SMC Fibonacci Bot
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/auto_forex
EnvironmentFile=/home/ubuntu/auto_forex/.env
ExecStart=/home/ubuntu/auto_forex/.venv/bin/python -m forex_bot.main
Restart=always
RestartSec=10
KillSignal=SIGTERM
TimeoutStopSec=30
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
